<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.azure.mapper.CouponMapper">

    <update id="updateCoupon" parameterType="com.azure.entity.Coupon">
        update coupon
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="type != null">type = #{type},</if>
            <if test="totalStock != null">total_stock = #{totalStock},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="discountAmount != null">discount_amount = #{discountAmount},</if>
            <if test="thresholdAmount != null">threshold_amount = #{thresholdAmount},</if>
            <if test="price != null">price = #{price},</if>
            <if test="status != null">status = #{status},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="validTime != null">valid_time = #{validTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where id = #{id}
    </update>

    <select id="pageQuery" parameterType="com.azure.dto.coupon.CouponPageQueryDTO" resultType="com.azure.vo.coupon.CouponVO">
        select * from coupon
        <where>
            <if test="name != null"> and name like concat('%', #{name}, '%') </if>
            <if test="type != null"> and type = #{type} </if>
            <if test="status != null"> and status = #{status} </if>
            <if test="activityStatus != null">
                <if test="activityStatus == 0">
                    and start_time > now()
                </if>
                <if test="activityStatus == 1">
                    and start_time &lt;= now() and end_time > now()
                </if>
                <if test="activityStatus == 2">
                    and end_time &lt;= now()
                </if>
            </if>
        </where> order by end_time desc
    </select>

</mapper>
